[[0.2, 2.568, "ليش نحب الخصومات؟ فكّر فيها."], [2.848, 5.681, "نفس القميص بمية درهم، ما تبيه."], [5.961, 7.529, "بس لو كان بمئتين"], [7.589, 9.64, "وعليه خصم خمسين بالمية،"], [9.7, 11.081, "تحس إنك لازم تاخذه."], [11.361, 13.579, "نفس السعر، نفس القميص. ليش؟"], [14.029, 16.421, "عالم اقتصاد اسمه ريتشارد ثيلر،"], [16.481, 18.582, "خذ جائزة نوبل، فسّرها كذا."], [18.862, 20.615, "احنا ما نشتري الغرض بس،"], [20.675, 22.687, "نشتري إحساس إن الصفقة حلوة."], [22.967, 25.231, "والإحساس هذا يجي من الفرق"], [25.291, 27.52, "بين السعر اللي في بالك،"], [27.58, 29.322, "والسعر اللي تدفعه."], [29.602, 32.284, "وكل ما كبر الفرق، كبرت الفرحة."], [32.564, 35.866, "في ألفين واثنعش، شركة أمريكية كبيرة"], [35.926, 37.494, "اسمها جي سي بيني"], [37.554, 38.749, "قررت تكون صادقة."], [39.029, 41.015, "لا خصومات، لا كوبونات،"], [41.075, 43.083, "سعر واحد رخيص طول السنة."], [43.363, 45.372, "والنتيجة؟ الناس هجروها."], [45.822, 48.573, "مبيعاتها طاحت خمسة وعشرين بالمية،"], [48.633, 51.745, "وخسرت تسعمية وخمسة وثمانين مليون دولار"], [51.805, 54.501, "في سنة وحدة. وبعدها رجّعت الخصومات."], [54.951, 56.402, "يعني الخصم مب دايماً"], [56.462, 57.774, "حيلة من المحل."], [58.054, 59.946, "أحياناً احنا اللي نطلبه."], [60.226, 62.037, "والحين، تعرفون ليش."]]