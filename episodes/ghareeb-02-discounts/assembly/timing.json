[[0.25, 3.33, "ليش نحب الخصومات؟ فكّر فيها."], [3.71, 6.4, "نفس القميص بمية درهم، ما تبيه."], [6.78, 8.33, "بس لو كان بميتين وعليه"], [8.33, 10.01, "خصم خمسين بالمية،"], [10.17, 11.59, "تحس إنك لازم تاخذه."], [11.97, 14.91, "نفس السعر، نفس القميص. ليش؟"], [15.46, 17.74, "عالم اقتصاد اسمه ريتشارد ثيلر،"], [17.9, 20.44, "خذ جايزة نوبل، فسّرها جذي."], [20.82, 22.3, "نحن ما نشتري الغرض بس،"], [22.46, 24.96, "نشتري إحساس إن الصفقة حلوة."], [25.34, 27.47, "والإحساس هذا يجي من الفرق"], [27.47, 29.09, "بين السعر اللي في بالك،"], [29.25, 30.62, "والسعر اللي تدفع."], [31.0, 33.52, "وكل ما كبر الفرق، كبرت الفرحة."], [33.9, 36.84, "في 2012، شركة أمريكية كبيرة"], [37.0, 38.56, "اسمها جي سي بيني،"], [38.72, 40.09, "قررت تكون صادقة."], [40.47, 42.71, "لا خصومات، لا كوبونات،"], [42.87, 44.75, "سعر واحد رخيص طول السنة."], [45.13, 47.7, "والنتيجة؟ الناس هجروها."], [48.25, 50.84, "المبيعات طاحت 25%،"], [51.0, 54.08, "وخسرت 985 مليون دولار"], [54.24, 57.81, "في سنة واحدة، وبعدها رجعت الخصومات."], [58.36, 60.51, "يعني، الخصم مب دايماً"], [60.51, 62.12, "حيلة من المحل."], [62.5, 64.64, "أحياناً نحن اللي نطلبه."], [65.02, 68.629, "والحين، تعرفون ليش نحب الخصومات؟"]]